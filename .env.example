# ─── Go Backend ───
GO_ENV=development
GO_PORT=8080
GO_LOG_LEVEL=debug

# ─── PostgreSQL ───
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=zkidentity
POSTGRES_PASSWORD=changeme
POSTGRES_DB=zk_device_identity
POSTGRES_SSLMODE=disable

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Qdrant (Vector DB) ───
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=device_fingerprints

# ─── Rust Proxy ───
RUST_PROXY_PORT=443
RUST_PROXY_TLS_CERT_PATH=
RUST_PROXY_TLS_KEY_PATH=
RUST_PROXY_RATE_LIMIT_RPM=1000

# ─── JWT ───
JWT_SECRET=replace-with-a-strong-secret-at-least-32-chars
JWT_ISSUER=zk-device-identity-saas
JWT_EXPIRY_HOURS=24

# ─── API Keys ───
API_KEY_ENCRYPTION_KEY=replace-with-32-byte-hex-key

# ─── Noir Proving Service ───
NOIR_PROVER_URL=http://localhost:3001
NOIR_PROVER_API_KEY=

# ─── RISC Zero Proving Service ───
RISC0_PROVER_URL=http://localhost:3002
RISC0_PROVER_API_KEY=

# ─── Julia Analysis Engine ───
JULIA_ANALYSIS_URL=http://localhost:8090
JULIA_ANALYSIS_API_KEY=

# ─── Agent Service (LangGraph/CrewAI) ───
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_API_KEY=

# ─── MCP Server ───
MCP_SERVER_PORT=3003

# ─── PQC / TLS ───
PQC_ENABLED=true
PQC_HYBRID_TLS=true

# ─── Tetragon ───
TETRAGON_ENABLED=false

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
